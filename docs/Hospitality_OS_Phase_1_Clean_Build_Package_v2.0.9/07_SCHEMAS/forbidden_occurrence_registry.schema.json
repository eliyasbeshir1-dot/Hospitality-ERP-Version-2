{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://hospitalityos.local/schemas/forbidden_occurrence_registry-1.0.json",
 "title": "Hospitality OS Canonical Forbidden Occurrence Registry",
 "description": "Authorizes existing canonical text only. Never authorizes future wording patterns. Character offsets are diagnostics and are NOT part of occurrence identity.",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "version",
  "normalization_version",
  "status",
  "governed_fields_sha256",
  "classification_enum",
  "expected_occurrence_count",
  "authorization_policy",
  "amendment_policy",
  "count",
  "occurrences"
 ],
 "properties": {
  "version": {
   "type": "string"
  },
  "normalization_version": {
   "type": "string"
  },
  "status": {
   "const": "canonical"
  },
  "governed_fields_sha256": {
   "type": "string",
   "pattern": "^[a-f0-9]{64}$"
  },
  "classification_enum": {
   "type": "array",
   "minItems": 5,
   "maxItems": 5,
   "items": {
    "enum": [
     "permitted_operational_sense",
     "fenced_negative_statement",
     "deferral_reference",
     "extension_contract_documentation",
     "vocabulary_definition"
    ]
   }
  },
  "expected_occurrence_count": {
   "type": "integer",
   "minimum": 1
  },
  "authorization_policy": {
   "type": "string",
   "minLength": 1
  },
  "amendment_policy": {
   "type": "string",
   "minLength": 1
  },
  "count": {
   "type": "integer",
   "minimum": 1
  },
  "occurrences": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "occurrence_id",
     "record_id",
     "record_type",
     "field",
     "term_id",
     "term",
     "domain",
     "normalization_version",
     "normalized_sentence_sha256",
     "occurrence_ordinal",
     "exact_excerpt",
     "excerpt_sha256",
     "classification",
     "meaning",
     "authorizing_reference",
     "introduced_by_amendment",
     "rationale"
    ],
    "properties": {
     "occurrence_id": {
      "type": "string",
      "pattern": "^FOC-[0-9]{4,}$"
     },
     "record_id": {
      "type": "string",
      "minLength": 1
     },
     "record_type": {
      "enum": [
       "requirement",
       "requirement_clause",
       "decision",
       "journey",
       "non_regression_rule",
       "negative_control",
       "state_machine",
       "event"
      ]
     },
     "field": {
      "type": "string",
      "minLength": 1
     },
     "term_id": {
      "type": "string",
      "pattern": "^TERM-[A-Z0-9_]+$"
     },
     "term": {
      "type": "string",
      "minLength": 1
     },
     "domain": {
      "type": "string",
      "minLength": 1
     },
     "normalization_version": {
      "type": "string"
     },
     "normalized_sentence_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
     },
     "occurrence_ordinal": {
      "type": "integer",
      "minimum": 1
     },
     "exact_excerpt": {
      "type": "string",
      "minLength": 1
     },
     "excerpt_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
     },
     "classification": {
      "enum": [
       "permitted_operational_sense",
       "fenced_negative_statement",
       "deferral_reference",
       "extension_contract_documentation",
       "vocabulary_definition"
      ]
     },
     "meaning": {
      "type": "string",
      "minLength": 1
     },
     "authorizing_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "type",
       "id"
      ],
      "properties": {
       "type": {
        "enum": [
         "requirement",
         "decision",
         "non_regression_rule"
        ]
       },
       "id": {
        "type": "string",
        "minLength": 1
       }
      }
     },
     "introduced_by_amendment": {
      "type": "string",
      "pattern": "^AMD-[A-Z0-9-]+$"
     },
     "rationale": {
      "type": "string",
      "minLength": 1
     },
     "diagnostic_char_offset": {
      "type": "integer",
      "minimum": 0,
      "description": "Diagnostics only. Never authoritative for occurrence identity."
     }
    }
   }
  }
 }
}
